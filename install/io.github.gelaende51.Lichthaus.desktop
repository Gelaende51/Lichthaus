[Desktop Entry]
# Not a launcher: the app id the daemon registers with xdg-desktop-portal
# (haus/videofollow.py), so the screen-cast permission dialog names Lichthaus
# and its "allow restoring" grant is kept under this id.
Type=Application
Name=Lichthaus
Name[de]=Lichthaus
Comment=Smart bulbs follow the screen
Comment[de]=Lampen folgen dem Bildschirm
Icon=brightness-high
Exec=lichthaus-ctl get
NoDisplay=true
Terminal=false
Actions=Settings;

[Desktop Action Settings]
Name=Settings
Name[de]=Einstellungen
Icon=brightness-high
Exec=lichthaus config
