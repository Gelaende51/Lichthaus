[Desktop Entry]
# Plasma 6 System Settings entry (no KCM: System Settings starts Exec as an
# external application). install/install.sh puts it in
# ~/.local/share/plasma/systemsettings/externalmodules/ with Exec's full path.
Type=Service
Exec=lichthaus config
Icon=brightness-high
X-KDE-ServiceTypes=SystemSettingsExternalApp
X-KDE-System-Settings-Parent-Category=hardware
X-KDE-Weight=90
Name=Lichthaus
Comment=Bulbs that follow the screen: bulbs, profiles, sound, video, notifications
Comment[de]=Lampen, die dem Bildschirm folgen: Lampen, Profile, Ton, Video, Benachrichtigungen
X-KDE-Keywords=light,lights,bulb,lamp,smart bulb,Lichthaus
X-KDE-Keywords[de]=Licht,Lampe,Lampen,Glühbirne,smarte Lampe,Lichthaus
